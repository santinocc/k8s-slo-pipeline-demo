# Copy to .env and adjust for local development. Placeholders only.
# Never put real credentials in this file or commit .env.

# PostgreSQL connection (used by the API and the pipeline CronJob)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slo_demo
POSTGRES_USER=slo_demo
POSTGRES_PASSWORD=change-me

# API settings
APP_LOG_LEVEL=info
# Enables the /chaos error-injection endpoint (M4 demo only)
CHAOS_ENABLED=false
